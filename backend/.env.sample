# Fabric SQL Connection

# Authentication=ActiveDirectoryInteractive: this is for local development only.
# Authentication=ActiveDirectoryMsi: For production, if the app is hosted in Azure (e.g., Azure App Service, Azure Functions).
# Authentication=ActiveDirectoryServicePrincipal: For production or non-Azure environments

# Service principal (recommended for authentication automation)
# A. Azure portal: create a service principal

# Create an App registration (Entra ID → App registrations → New).
# Record Application (client) ID and Directory (tenant) ID; create a client secret (Certificates & secrets → New client secret).

# B. Fabric portal: grant the service principal access

# Open your SQL Database item in Fabric.
# Security → Manage SQL security.
# Pick needed role(s) (e.g., db_datareader, db_datawriter, db_ddladmin) → Manage access.
# Add the service principal (search by display name) and Grant.
# This creates the external SQL user for the app automatically.
#  [learn.microsoft.com], [a_deep_div...oft_fabric | PDF]

# C. (Tenant admin) Fabric tenant setting
# Ensure “Service principals can use Fabric APIs” is Enabled in Tenant settings.

FABRIC_SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=<your-server>.database.fabric.microsoft.com,1433;Database={<your-database>};Encrypt=yes;TrustServerCertificate=no;Authentication=ActiveDirectoryInteractive

# Frontend CORS
FRONTEND_ORIGIN=http://localhost:3000

# Azure OpenAI (for Agent feature)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-5-mini
